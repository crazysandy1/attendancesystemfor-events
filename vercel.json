{
  "buildCommand": "npm ci && npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/(?!api/|_next/|static/|public/|manifest\\.json|favicon\\.ico|logo\\.jpeg).*",
      "dest": "/index.html",
      "methods": ["GET", "HEAD"]
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
